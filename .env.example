# Supabase PostgreSQL: pooled runtime URL (port 6543) & direct migration/seed URL (port 5432)
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth (secret min 32 chars; production URL e.g. https://your-app.vercel.app)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Google Gemini API key (Weekly Plan & Daily Check-in AI)
GOOGLE_GENERATIVE_AI_API_KEY=

# Web Push VAPID keys & contact mailto: subject
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for /api/cron/reminders (30-min external cron via cron-job.org or GitHub Actions)
CRON_SECRET=

# Comma-separated emails allowed to sign in (empty = anyone)
ALLOWED_EMAILS=
